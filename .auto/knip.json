{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "ignoreBinaries": ["electron-builder", "electron-vite", "xvfb-run"],
  "workspaces": {
    ".": {
      "entry": ["scripts/*.{mjs,cjs,js,ts}", "oxlint.config.ts"],
      "project": ["scripts/**/*.{mjs,cjs,js,ts}", "oxlint.config.ts"]
    },
    "apps/desktop": {
      "entry": [
        "electron.vite.config.ts",
        "src/renderer/vite.config.ts",
        "src/main/index.ts",
        "src/preload/index.ts",
        "src/renderer/src/main.tsx",
        "src/main/databases/puzzle-scan-worker.ts",
        "src/main/repertoire/import-worker.ts",
        "src/main/repertoire/import-writer-worker.ts",
        "src/main/repertoire/backup-restore-worker.ts",
        "e2e/**/*.ts",
        "src/**/*.test.ts",
        "src/**/*.test.tsx"
      ],
      "project": ["src/**/*.{ts,tsx}", "e2e/**/*.ts", "electron.vite.config.ts"]
    },
    "apps/marketing": {
      "entry": ["vite.config.ts", "src/main.ts", "index.html"],
      "project": ["src/**/*.{ts,tsx}", "vite.config.ts"]
    },
    "packages/shared": {
      "entry": ["src/**/*.ts", "scripts/**/*.mjs"],
      "project": ["src/**/*.ts", "scripts/**/*.mjs"]
    }
  },
  "ignoreDependencies": ["@chaturanga/shared", "oxlint-tsgolint"]
}
