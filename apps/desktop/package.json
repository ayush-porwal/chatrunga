{
  "name": "@chaturanga/desktop",
  "productName": "Chaturanga",
  "version": "0.1.0",
  "description": "A desktop chess app with PGN study and UCI engine play.",
  "main": "out/main/index.js",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "node ../../scripts/ensure-electron.cjs && electron-vite dev",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.renderer.json && tsc --noEmit -p tsconfig.main.json && tsc --noEmit -p e2e/tsconfig.json",
    "build": "pnpm run typecheck && electron-vite build",
    "preview": "electron-vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "pnpm build && pnpm run test:e2e:run",
    "test:e2e:run": "playwright test -c e2e/playwright.config.ts",
    "dist:mac": "pnpm build && electron-builder --mac --publish never",
    "dist:win": "pnpm build && electron-builder --win --publish never",
    "dist:linux": "pnpm build && electron-builder --linux --publish never"
  },
  "build": {
    "appId": "com.chaturanga.desktop",
    "productName": "Chaturanga",
    "directories": {
      "output": "dist",
      "buildResources": "src/main/assets"
    },
    "electronLanguages": ["en", "en-US"],
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "src/main/assets",
        "to": ".",
        "filter": ["app-icon.png"]
      }
    ],
    "mac": {
      "icon": "src/main/assets/app-icon.icns",
      "category": "public.app-category.board-games",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "identity": "-"
    },
    "dmg": {
      "title": "Chaturanga ${version}"
    },
    "artifactName": "Chaturanga-${version}-${os}-${arch}.${ext}",
    "publish": [
      {
        "provider": "github",
        "owner": "ayush-porwal",
        "repo": "chatrunga",
        "releaseType": "release"
      }
    ],
    "win": {
      "icon": "src/main/assets/app-icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Chaturanga",
      "artifactName": "Chaturanga-${version}-win-${arch}-setup.${ext}"
    },
    "linux": {
      "icon": "src/main/assets/app-icon.png",
      "category": "Game",
      "synopsis": "Chess game review with engine analysis and an AI coach",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  },
  "devDependencies": {
    "@chaturanga/shared": "workspace:*",
    "@electron/asar": "3.4.1",
    "@lichess-org/chessground": "^10.1.1",
    "@playwright/test": "1.63.0",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/react-query": "^5.100.9",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^25.6.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "canvas-confetti": "^1.9.4",
    "chessops": "^0.15.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron": "^42.0.1",
    "electron-builder": "^26.8.1",
    "electron-updater": "^6.8.9",
    "electron-vite": "^5.0.0",
    "fzstd": "^0.1.1",
    "lucide-react": "^1.14.0",
    "nanoid": "^5.1.11",
    "react": "^19.2.6",
    "react-colorful": "^5.7.0",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.1.0",
    "recharts": "^3.8.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.11",
    "vitest": "^4.1.5",
    "zustand": "^5.0.13"
  },
  "homepage": "https://github.com/ayush-porwal/chatrunga"
}
