{
  "name": "@chaturanga/desktop",
  "productName": "Chaturanga",
  "version": "0.1.0",
  "description": "A desktop chess app with PGN study and UCI engine play.",
  "main": "out/main/index.js",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "tsc --noEmit -p tsconfig.json && electron-vite build",
    "preview": "electron-vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "dist:mac": "pnpm build && electron-builder --mac --publish never",
    "dist:mac:alpha": "pnpm build && electron-builder --mac dmg --publish never -c.appId=com.chaturanga.desktop.alpha -c.productName='Chaturanga Alpha' -c.artifactName='Chaturanga-Alpha-${version}-${os}-${arch}.${ext}' -c.mac.identity=null -c.dmg.title='Chaturanga Alpha ${version}'"
  },
  "build": {
    "appId": "com.chaturanga.desktop",
    "productName": "Chaturanga",
    "directories": {
      "output": "dist",
      "buildResources": "src/main/assets"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "src/main/assets",
        "to": ".",
        "filter": [
          "app-icon.icns",
          "app-icon.png"
        ]
      },
      {
        "from": "src/main/assets/engines",
        "to": "engines",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "icon": "src/main/assets/app-icon.icns",
      "category": "public.app-category.board-games",
      "target": [
        "dmg"
      ],
      "identity": null
    },
    "dmg": {
      "title": "Chaturanga ${version}"
    }
  },
  "dependencies": {
    "@chaturanga/shared": "workspace:*",
    "@lichess-org/chessground": "^10.1.1",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/react-query": "^5.100.9",
    "chessops": "^0.15.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "fzstd": "^0.1.1",
    "lucide-react": "^1.14.0",
    "nanoid": "^5.1.11",
    "react": "^19.2.6",
    "react-colorful": "^5.7.0",
    "react-dom": "^19.2.6",
    "recharts": "^3.8.1",
    "stockfish": "18.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@types/node": "^25.6.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "drizzle-kit": "^0.31.10",
    "electron": "^42.0.1",
    "electron-builder": "^26.8.1",
    "electron-vite": "^5.0.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.11",
    "vitest": "^4.1.5"
  }
}
