{
  "name": "chaturanga-monorepo",
  "private": true,
  "packageManager": "pnpm@11.0.9+sha512.34ce82e6780233cf9cad8685029a8f81d2e06196c5a9bad98879f7424940c6817c4e4524fb7d38b8553ceed48b9758b8ebaf1abd3600c232c4c8cf7366086f38",
  "type": "module",
  "engines": {
    "node": "24.15.0",
    "pnpm": "11.0.9"
  },
  "scripts": {
    "dev": "pnpm --filter @chaturanga/desktop dev",
    "dev:desktop": "pnpm --filter @chaturanga/desktop dev",
    "dev:marketing": "pnpm --filter @chaturanga/marketing dev",
    "build": "pnpm -r build",
    "build:desktop": "pnpm --filter @chaturanga/desktop build",
    "build:marketing": "pnpm --filter @chaturanga/marketing build",
    "preview": "pnpm --filter @chaturanga/desktop preview",
    "test": "pnpm -r test",
    "test:coverage": "pnpm --filter @chaturanga/shared test:coverage && pnpm --filter @chaturanga/desktop test:coverage",
    "lint": "eslint .",
    "format": "prettier --write .",
    "dist:mac": "pnpm --filter @chaturanga/desktop dist:mac",
    "db:generate": "pnpm --filter @chaturanga/desktop db:generate",
    "generate:piece-css": "node scripts/generate-piece-theme-css.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.59.1",
    "@types/node": "^25.6.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^4.1.5",
    "electron": "^42.0.1",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "stockfish"
    ]
  }
}
