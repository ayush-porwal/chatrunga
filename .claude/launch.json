      "runtimeArgs": [
        "dev:marketing"
      ],
      "port": 5180
    },
    {
      "name": "desktop-renderer",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "dev:desktop"
      ],
      "port": 5173
